# --- Compte Google (créez un "mot de passe d'application" sur myaccount.google.com/apppasswords)
GMAIL_ADDRESS=votre-adresse@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- API Gemini — GRATUITE, sans carte bancaire
# Créez la clé sur aistudio.google.com/apikey avec votre compte Google.
GEMINI_API_KEY=...

# --- Firebase (Console Firebase > Paramètres du projet > Comptes de service > Générer une nouvelle clé privée)
# Collez ici le CONTENU ENTIER du fichier JSON téléchargé, sur une seule ligne.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# --- Identifiant de l'utilisateur KBM dans Firestore (users/{CET_ID}/emails)
# C'est le "UID" visible dans Firebase Authentication > Users, en face de votre compte.
KBM_USER_ID=

# --- Signature ajoutée automatiquement à la fin de chaque réponse envoyée
SIGNATURE="KBM Toiture\nContact : 06 12 34 56 78"
